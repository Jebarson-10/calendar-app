+    function renderMiniCal(){const el=document.getElementById('mini-cal');const year=currentDate.getFullYear(),month=currentDate.getMonth();const first=new Date(year,month,1),last=new Date(year,month+1,0);const startDay=first.getDay();const today=new Date();const eventDates=new Set(events.map(e=>e.start_time.split('T')[0]));let html=`<div class="cal-nav"><button onclick="changeMonth(-1)">‹</button><span style="font-size:15px;font-weight:500">${MONTHS[month]} ${year}</span><button onclick="changeMonth(1)">›</button></div><div class="cal-grid'>`;DAYS.forEach(d=>html+=`<div class="cal-day-label">${d}</div>`);for(let i=0;i<startDay;i++){const d=new Date(year,month,-(startDay-1-i));html+=`<div class="cal-day other-month">${d.getDate()}</div>`}for(let d=1;d<=last.getDate();d++){const dateStr=`${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;const isToday=d===today.getDate()&&month===today.getMonth()&&year===today.getFullYear();const isSel=d===selectedDate.getDate()&&month===selectedDate.getMonth()&&year===selectedDate.getFullYear();let cls='cal-day';if(isToday)cls+=' today';if(isSel)cls+=' selected';if(eventDates.has(dateStr))cls+=' has-event';html+=`<div class="${cls}" onclick="selectDate(${year},${month},${d})">${d}</div>`}const totalCells=startDay+last.getDate();const remaining=(7-totalCells%7)%7;for(let i=1;i<=remaining;i++)html+=`<div class="cal-day other-month">${i}</div>`;html+='</div>';el.innerHTML=html}
