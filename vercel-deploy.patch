+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Book an Appointment</title>
+  <style>
+    :root{--bg:#0f1117;--surface:#1a1d27;--surface2:#242836;--border:#2e3348;--text:#e4e6f0;--text2:#8b8fa8;--accent:#6c5ce7;--accent2:#a29bfe;--green:#00b894;--red:#e17055;--blue:#74b9ff;--radius:12px}
+    *{margin:0;padding:0;box-sizing:border-box}
+    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
+    .container{max-width:900px;margin:0 auto;padding:40px 24px}
+    .hero{text-align:center;margin-bottom:40px}.hero h1{font-size:28px;margin-bottom:8px}.hero h1 span{color:var(--accent2)}.hero p{color:var(--text2);font-size:15px}
+    .layout{display:grid;grid-template-columns:1fr 1fr;gap:32px}@media(max-width:700px){.layout{grid-template-columns:1fr}}
+    .cal-section{background:var(--surface);border-radius:16px;padding:24px;border:1px solid var(--border)}.cal-section h2{font-size:16px;margin-bottom:16px}
+    .cal-nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
+    .cal-nav button{background:none;border:none;color:var(--text2);cursor:pointer;font-size:20px;padding:4px 10px;border-radius:6px}.cal-nav button:hover{background:var(--surface2);color:var(--text)}
+    .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center}
+    .cal-day-label{font-size:11px;color:var(--text2);padding:8px 0}
+    .cal-day{padding:10px 0;font-size:14px;border-radius:8px;cursor:pointer;transition:.15s;color:var(--text2)}.cal-day:hover{background:var(--surface2)}
+    .cal-day.today{color:var(--accent2);font-weight:600}.cal-day.selected{background:var(--accent);color:#fff;font-weight:600}
+    .cal-day.other-month{opacity:.25;pointer-events:none}.cal-day.past{opacity:.3;pointer-events:none}
+    .cal-day.available{color:var(--green)}.cal-day.available::after{content:'';display:block;width:5px;height:5px;background:var(--green);border-radius:50%;margin:3px auto 0}
+    .slots-section{margin-top:20px}.slots-section h3{font-size:14px;margin-bottom:12px;color:var(--text2)}
+    .time-slots{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
+    .time-slot{padding:10px;text-align:center;background:var(--surface2);border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:13px;transition:.2s}
+    .time-slot:hover{border-color:var(--accent)}.time-slot.selected{background:var(--accent);border-color:var(--accent);color:#fff}
+    .form-section{background:var(--surface);border-radius:16px;padding:24px;border:1px solid var(--border)}.form-section h2{font-size:16px;margin-bottom:16px}
+    .form-group{margin-bottom:16px}.form-group label{display:block;font-size:13px;color:var(--text2);margin-bottom:6px}
+    .form-group input,.form-group textarea{width:100%;padding:11px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:14px;font-family:inherit}
+    .form-group input:focus,.form-group textarea:focus{outline:none;border-color:var(--accent)}
+    .form-row{display:flex;gap:12px}.form-row .form-group{flex:1}
+    .btn-submit{width:100%;padding:14px;background:var(--accent);color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;transition:.2s}
+    .btn-submit:hover{opacity:.85}.btn-submit:disabled{opacity:.4;cursor:not-allowed}
+    .confirmation{display:none;text-align:center;padding:60px 24px}.confirmation.show{display:block}
+    .confirmation .icon{font-size:60px;margin-bottom:16px}.confirmation h2{margin-bottom:8px}.confirmation p{color:var(--text2);font-size:15px;margin-bottom:24px}
+    .toast{position:fixed;bottom:24px;right:24px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 20px;font-size:14px;z-index:200;transform:translateY(100px);opacity:0;transition:.3s}
+    .toast.show{transform:translateY(0);opacity:1}.toast.error{border-left:3px solid var(--red)}
+    .footer{text-align:center;margin-top:40px;color:var(--text2);font-size:13px}
+  </style>
+</head>
+<body>
+  <div class="container">
+    <div class="hero"><h1>📅 Book an <span>Appointment</span></h1><p>Select a date and time, then fill in your details to request a meeting.</p></div>
+    <div id="booking-form">
+      <div class="layout">
+        <div class="cal-section">
+          <h2>📆 Select a Date</h2>
+          <div id="picker-cal"></div>
+          <div class="slots-section" id="slots-container" style="display:none">
+            <h3 id="slots-title">Available times</h3>
+            <div class="time-slots" id="time-slots"></div>
+          </div>
+        </div>
+        <div class="form-section">
+          <h2>📝 Your Details</h2>
+          <div id="selected-info" style="display:none;margin-bottom:16px;padding:12px;background:var(--surface2);border-radius:8px;font-size:13px;color:var(--accent2)"></div>
+          <div class="form-group"><label>Your Name *</label><input type="text" id="req-name" placeholder="John Doe"></div>
+          <div class="form-group"><label>Email *</label><input type="email" id="req-email" placeholder="john@example.com"></div>
+          <div class="form-group"><label>Meeting Title *</label><input type="text" id="req-title" placeholder="Project sync, Interview, etc."></div>
+          <div class="form-group"><label>Description</label><textarea id="req-desc" rows="3" placeholder="What would you like to discuss?"></textarea></div>
+          <div class="form-group"><label>Your Meeting Link</label><input type="url" id="req-link" placeholder="https://zoom.us/j/... or meet.google.com/..."></div>
+          <div class="form-row" id="time-inputs">
+            <div class="form-group"><label>Start Time *</label><input type="time" id="req-start" value="09:00"></div>
+            <div class="form-group"><label>End Time *</label><input type="time" id="req-end" value="09:30"></div>
+          </div>
+          <button class="btn-submit" id="submit-btn" onclick="submitRequest()">Request Appointment</button>
+        </div>
+      </div>
+    </div>
+    <div class="confirmation" id="confirmation">
+      <div class="icon">🎉</div><h2>Request Submitted!</h2><p>Your appointment request has been sent. You'll be notified once it's reviewed.</p>
+      <button class="btn-submit" style="max-width:300px;margin:0 auto" onclick="resetForm()">Book Another</button>
+    </div>
+    <div class="footer">Powered by Calendar App</div>
+  </div>
+  <div class="toast" id="toast"></div>
+  <script>
+    let availability=[],selectedDate=null,selectedSlot=null;
+    const DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'],MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];
+    const currentMonth={y:new Date().getFullYear(),m:new Date().getMonth()};
+
+    document.addEventListener('DOMContentLoaded',async()=>{const r=await fetch('/api/book');availability=await r.json();renderPicker()});
+
+    function renderPicker(){const el=document.getElementById('picker-cal');const{y,m}=currentMonth;const first=new Date(y,m,1),last=new Date(y,m+1,0);const startDay=first.getDay();const today=new Date();today.setHours(0,0,0,0);const availDays=new Set(availability.filter(a=>a.enabled).map(a=>a.day_of_week));let html=`<div class="cal-nav"><button onclick="pickerNav(-1)">‹</button><span style="font-size:15px;font-weight:500">${MONTHS[m]} ${y}</span><button onclick="pickerNav(1)">›</button></div><div class="cal-grid">`;DAYS.forEach(d=>html+=`<div class="cal-day-label">${d}</div>`);for(let i=0;i<startDay;i++)html+=`<div class="cal-day other-month"></div>`;for(let d=1;d<=last.getDate();d++){const dt=new Date(y,m,d);const dateStr=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;const dow=dt.getDay();const isPast=dt<today;const isToday=dt.getTime()===today.getTime();const isSel=selectedDate===dateStr;const isAvail=availDays.has(dow)&&!isPast;let cls='cal-day';if(isPast)cls+=' past';if(isToday)cls+=' today';if(isSel)cls+=' selected';if(isAvail)cls+=' available';html+=`<div class="${cls}" onclick="pickDate('${dateStr}',${dow})">${d}</div>`}html+='</div>';el.innerHTML=html}
+
+    function pickerNav(delta){currentMonth.m+=delta;if(currentMonth.m<0){currentMonth.m=11;currentMonth.y--}if(currentMonth.m>11){currentMonth.m=0;currentMonth.y++}renderPicker()}
+    function pickDate(dateStr,dow){selectedDate=dateStr;selectedSlot=null;renderPicker();showTimeSlots(dateStr,dow)}
+
+    function showTimeSlots(dateStr,dow){const container=document.getElementById('slots-container');const slotsEl=document.getElementById('time-slots');const titleEl=document.getElementById('slots-title');const avail=availability.find(a=>a.day_of_week===dow);if(!avail||!avail.enabled){container.style.display='none';return}titleEl.textContent=`Available on ${DAYS[dow]}`;const[sh]=avail.start_hour.split(':').map(Number);const[eh]=avail.end_hour.split(':').map(Number);let slots=[];for(let h=sh;h<eh;h++)for(let m=0;m<60;m+=30)slots.push(`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`);slotsEl.innerHTML=slots.map(s=>`<div class="time-slot ${selectedSlot===s?'selected':''}" onclick="pickSlot('${s}')">${formatSlotTime(s)}</div>`).join('');container.style.display='block'}
+
+    function pickSlot(time){selectedSlot=time;const dow=new Date(selectedDate).getDay();showTimeSlots(selectedDate,dow);const[h,m]=time.split(':').map(Number);let eh=h,em=m+30;if(em>=60){eh++;em-=60}document.getElementById('req-start').value=time;document.getElementById('req-end').value=`${String(eh).padStart(2,'0')}:${String(em).padStart(2,'0')}`;const info=document.getElementById('selected-info');const d=new Date(selectedDate);info.textContent=`📅 ${DAYS[dow]}, ${MONTHS[d.getMonth()]} ${d.getDate()} at ${formatSlotTime(time)}`;info.style.display='block'}
+
+    async function submitRequest(){const name=document.getElementById('req-name').value.trim(),email=document.getElementById('req-email').value.trim(),title=document.getElementById('req-title').value.trim(),desc=document.getElementById('req-desc').value.trim(),link=document.getElementById('req-link').value.trim(),start=document.getElementById('req-start').value,end=document.getElementById('req-end').value;if(!name||!email||!title||!selectedDate||!start||!end)return showToast('Please fill all required fields and select a date','error');if(!email.includes('@'))return showToast('Please enter a valid email','error');const btn=document.getElementById('submit-btn');btn.disabled=true;btn.textContent='Submitting...';try{const res=await fetch('/api/book',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({requester_name:name,requester_email=email,title,description:desc,requested_date:selectedDate,requested_start:start,requested_end:end,meeting_link:link})});const data=await res.json();if(!res.ok){showToast(data.error||'Error','error');btn.disabled=false;btn.textContent='Request Appointment';return}document.getElementById('booking-form').style.display='none';document.getElementById('confirmation').classList.add('show')}catch(err){showToast('Network error','error')}btn.disabled=false;btn.textContent='Request Appointment'}
+
+    function resetForm(){document.getElementById('booking-form').style.display='block';document.getElementById('confirmation').classList.remove('show');selectedDate=null;selectedSlot=null;document.getElementById('req-name').value='';document.getElementById('req-email').value='';document.getElementById('req-title').value='';document.getElementById('req-desc').value='';document.getElementById('req-link').value='';document.getElementById('selected-info').style.display='none';document.getElementById('slots-container').style.display='none';renderPicker()}
+    function formatSlotTime(t){const[h,m]=t.split(':').map(Number);const hr=h>12?h-12:h||12;return`${hr}:${String(m).padStart(2,'0')} ${h>=12?'PM':'AM'}`}
+    function showToast(msg,type){const t=document.getElementById('toast');t.textContent=msg;t.className=`toast ${type} show`;setTimeout(()=>t.classList.remove('show'),3000)}
+  </script>
+</body>
+</html>
