+    async function saveEvent(){const id=document.getElementById('evt-id').value;const date=document.getElementById('evt-date').value;const data={title:document.getElementById('evt-title').value,description:document.getElementById('evt-desc').value,start_time:`${date}T${document.getElementById('evt-start').value}`,end_time:`${date}T${document.getElementById('evt-end').value}`,location:document.getElementById('evt-location').value,meeting_link:document.getElementById('evt-link').value,color:document.getElementById('evt-color').value,is_blocking:document.getElementById('evt-blocking').checked,status:'confirmed'};if(!data.title)return showToast('Title required','error');if(id){await fetch(`/api/events?id=${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});showToast('Event updated','success')}else{await fetch('/api/events',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});showToast('Event created','success')}closeModal('event-modal');await loadEvents();renderMiniCal();renderTodayEvents();renderCalendarView()}
+
+    async function approveRequest(id){const note=prompt('Add a note (optional):');await fetch(`/api/requests?action=approve&id=${id}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({owner_note:note})});showToast('Approved!','success');await loadData();renderRequests()}
