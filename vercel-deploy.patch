+
+    function renderAvailability(){const el=document.getElementById('availability-grid');const names=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];el.innerHTML=availability.sort((a,b)=>a.day_of_week-b.day_of_week).map(a=>`<div class="avail-row"><div class="avail-day">${names[a.day_of_week]}</div><label class="avail-toggle"><input type="checkbox" ${a.enabled?'checked':''} onchange="toggleAvail(${a.day_of_week},this.checked)"><span class="slider"></span></label><div class="avail-times"><input type="time" value="${a.start_hour}" onchange="updateAvailTime(${a.day_of_week},'start',this.value)"><span>to</span><input type="time" value="${a.end_hour}" onchange="updateAvailTime(${a.day_of_week},'end',this.value)"></div></div>`).join('')}
