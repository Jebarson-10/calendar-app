+
+    function renderCalendarView(){const el=document.getElementById('calendar-view');const dateStr=`${selectedDate.getFullYear()}-${String(selectedDate.getMonth()+1).padStart(2,'0')}-${String(selectedDate.getDate()).padStart(2,'0')}`;const dayEvts=events.filter(e=>e.start_time.startsWith(dateStr));let html=`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px"><h2 style="font-size:18px">${DAYS[selectedDate.getDay()]}, ${MONTHS[selectedDate.getMonth()]} ${selectedDate.getDate()}, ${selectedDate.getFullYear()}</h2><button class="btn btn-primary btn-sm" onclick="openNewEvent('${dateStr}')">+ Add Event</button></div><div style="position:relative">`;for(let h=6;h<=22;h++){const hourStr=`${String(h).padStart(2,'0')}:00`;const hourEvts=dayEvts.filter(e=>parseInt(e.start_time.split('T')[1].split(':')[0])===h);html+=`<div style="display:flex;min-height:50px;border-bottom:1px solid var(--border)"><div style="width:60px;font-size:12px;color:var(--text2);padding:4px 8px;flex-shrink:0">${hourStr}</div><div style="flex:1;padding:4px 8px">${hourEvts.map(e=>`<div class="event-item" style="border-left-color:${e.color};margin-bottom:4px" onclick="editEvent(${e.id})"><div class="time">${formatTime(e.start_time)} – ${formatTime(e.end_time)}</div><div class="title">${esc(e.title)}</div>${e.location?`<div class="meta">📍 ${esc(e.location)}</div>`:''}${e.meeting_link?`<div class="link-badge">${esc(e.meeting_link)}</div>`:''}${e.is_blocking?'<div class="meta" style="color:var(--red)">🚫 Blocked</div>':''}</div>`).join('')}</div></div>`}html+='</div>';el.innerHTML=html}
